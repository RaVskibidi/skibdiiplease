# T77 dashboard website (API + web)
# Copy to .env in this folder. Never commit the filled file.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# ── Dashboard API ────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false

# ── Infrastructure ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://t77:t77_dev_only@localhost:5432/t77?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=t77
CACHE_TTL_SECONDS=300
DB_POOL_MAX=6
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500

# ── Discord OAuth2 ───────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-with-your-oauth-client-secret
DISCORD_REDIRECT_URI=http://127.0.0.1:4000/api/auth/discord/callback

# ── Secrets (generate unique values) ─────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Web (Vite, build time) ───────────────────────────────────────────────────
VITE_API_URL=/api
